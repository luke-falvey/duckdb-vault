# name: test/sql/env/vault_env_credentials.test
# description: Credentials from the environment are only sent to the Vault address from the environment
# group: [env]

# Run by scripts/run-integration-tests.sh with VAULT_ADDR and VAULT_TOKEN set in the environment

require vault

require httpfs

require-env VAULT_TEST_ENV_CREDENTIALS

require-env VAULT_ADDR

require-env VAULT_TOKEN

require-env VAULT_TEST_PORT

# vault_addr not set: the address and the token both come from the environment
query I
SELECT authenticated FROM vault_status();
----
true

# The same address set explicitly still uses the token from the environment
statement ok
SET vault_addr = '{VAULT_ADDR}';

query I
SELECT authenticated FROM vault_status();
----
true

# Any other address does not get the token from the environment. Here it is the same server under another name,
# so the only difference is the address.
statement ok
SET vault_addr = 'http://localhost:{VAULT_TEST_PORT}';

query II
SELECT authenticated, error LIKE '%no token was found%' FROM vault_status();
----
false	true

# Explicitly set credentials are used with any address
statement ok
SET vault_token = '{VAULT_TOKEN}';

query I
SELECT authenticated FROM vault_status();
----
true
